#!/usr/bin/env python3
"""Open Office files synced by OneDrive in the matching Office web app.

For each file under the OneDrive sync folder, look up its web link with the
abraunegg client (`onedrive --get-file-link`, read-only, uses the client's own
sign-in), cache it, and open it as an Omarchy web app. Anything else — a file
outside the sync folder, one not uploaded yet, or a failed lookup — opens in
LibreOffice instead.

Usage: onedrive-office-open [--refresh] FILE...
  --refresh   ignore the cached link and look it up again
"""

import json
import os
import re
import subprocess
import sys
from urllib.parse import unquote, urlparse

CONFIG_FILE = os.path.expanduser("~/.config/onedrive/config")
CACHE_FILE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                          "onedrive-office", "links.json")
LOOKUP_TIMEOUT_SEC = 60
FALLBACK = ["libreoffice"]

# Web links the client returns for OneDrive Personal and work/school accounts.
ALLOWED_URL = re.compile(r"^https://(onedrive\.live\.com|[A-Za-z0-9-]+\.sharepoint\.com)/[^\s\"'<>]*$")

APPS = {
    "Excel": {".xlsx", ".xlsm", ".xlsb", ".xls"},
    "Word": {".docx", ".docm", ".doc"},
    "PowerPoint": {".pptx", ".pptm", ".ppt", ".ppsx"},
}
GLYPHS = {"Excel": "\U000F021B", "Word": "\U000F022C", "PowerPoint": "\U000F0227"}


def app_for(path):
    ext = os.path.splitext(path)[1].lower()
    for app, exts in APPS.items():
        if ext in exts:
            return app
    return None


def notify(headline, description="", glyph="\U000F015F", urgency="low"):
    cmd = ["omarchy-notification-send", "--app-name", "OneDrive", "-g", glyph, "-u", urgency, headline]
    if description:
        cmd.append(description)
    try:
        subprocess.run(cmd, timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def sync_dir():
    path = "~/OneDrive"
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            for line in f:
                m = re.match(r'^\s*sync_dir\s*=\s*"([^"]*)"', line)
                if m:
                    path = m.group(1)
    except OSError:
        pass
    return os.path.realpath(os.path.expanduser(path))


def to_path(arg):
    if arg.startswith("file://"):
        return unquote(urlparse(arg).path)
    return arg


def load_cache():
    try:
        with open(CACHE_FILE, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_cache(cache):
    os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
    tmp = CACHE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cache, f, indent=1, sort_keys=True)
    os.replace(tmp, CACHE_FILE)


def lookup(rel, root):
    """The file's web link from the OneDrive client, or None."""
    try:
        out = subprocess.run(["onedrive", "--get-file-link", rel], cwd=root, capture_output=True,
                             text=True, timeout=LOOKUP_TIMEOUT_SEC)
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.stdout.splitlines():
        m = re.match(r"^WebURL:\s*(\S+)\s*$", line.strip())
        if m and ALLOWED_URL.match(m.group(1)):
            return m.group(1)
    return None


def open_local(path, reason=""):
    if reason:
        notify(f"Opening {os.path.basename(path)} in LibreOffice", reason)
    subprocess.Popen(["setsid", "uwsm-app", "--"] + FALLBACK + [path],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def open_web(url):
    subprocess.Popen(["omarchy-launch-webapp", url],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def main(argv):
    refresh = "--refresh" in argv
    files = [to_path(a) for a in argv if a != "--refresh"]
    if not files:
        print(__doc__.strip(), file=sys.stderr)
        return 2

    root = sync_dir()
    cache = load_cache()
    changed = False
    for arg in files:
        path = os.path.realpath(os.path.expanduser(arg))
        app = app_for(path)
        if not os.path.isfile(path) or app is None or not path.startswith(root + os.sep):
            open_local(path)
            continue

        rel = os.path.relpath(path, root)
        url = None if refresh else cache.get(rel)
        if not (isinstance(url, str) and ALLOWED_URL.match(url)):
            notify(f"Opening {os.path.basename(path)} in {app}", "Looking up its OneDrive link…", GLYPHS[app])
            url = lookup(rel, root)
            if url is None:
                open_local(path, "OneDrive has no link for it yet (not uploaded, or offline).")
                continue
            cache[rel] = url
            changed = True
        open_web(url)

    if changed:
        save_cache(cache)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
